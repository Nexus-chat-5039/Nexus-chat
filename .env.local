# ── Infrastructure (Docker service names instead of localhost) ──
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgres://root:rootpassword@postgres:5432/nexus?sslmode=disable

# ── Pub/Sub Emulator ──
GCP_PROJECT_ID=nexus-local
PUBSUB_EMULATOR_HOST=pubsub-emulator:8085

# ── Downstream services (Docker service names) ──
RAG_SERVICE_URL=nexus-rag:50051
GATEWAY_URL=nexus-ai-gateway:50052
BILLING_URL=nexus-billing:50053

# ── Qdrant (already set via docker-compose environment, but just in case) ──
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ── CORS (allow client dev server) ──
CORS_ORIGIN=http://localhost:5173

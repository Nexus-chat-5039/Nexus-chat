# ─────────────────────────────────────────────────────────────────
# NEXUS CHAT - PRODUCTION ENVIRONMENT TEMPLATE
# ─────────────────────────────────────────────────────────────────
# Instructions:
# 1. Copy this file to `.env.production`
# 2. Fill in all the values below with your production secrets
# 3. DO NOT commit `.env.production` to version control!

# ── Application Environment ──
ENV=production

# ── Database (Google Cloud SQL for PostgreSQL) ──
# Example: postgres://username:password@<ip-or-host>:5432/database_name?sslmode=require
DATABASE_URL=

# ── Redis (Google Cloud Memorystore) ──
# Example: redis://<redis-ip>:6379/0
REDIS_URL=

# ── Authentication ──
# Generate a secure 64+ character random string for this
JWT_SECRET=

# ── Security / CORS ──
# Comma-separated list of allowed origins (e.g., https://yourdomain.com)
CORS_ORIGIN=

# ── Frontend Configuration ──
# These must be set during the frontend build step (e.g. in Cloud Build / Actions)
VITE_REST_API_URL=
VITE_SOCKET_URL=

# ── Google Cloud Config ──
GOOGLE_CLOUD_PROJECT=
PUBSUB_EMULATOR_HOST= # Leave empty in production to use real GCP PubSub
